# Copy to .env and fill in. Never commit .env.

# --- GitHub (data source) -------------------------------------------------------
# Optional locally: if unset, Cairn uses `gh auth token`. Needs only public read access.
GITHUB_TOKEN=

# --- LLM providers (free tiers are enough) -------------------------------------------
# Groq: https://console.groq.com/keys          (ingestion: triage + extraction)
GROQ_API_KEY=
# Gemini: https://aistudio.google.com/apikey    (agent reasoning + answers)
GEMINI_API_KEY=
# Optional alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# TypeSafe JEV (early access): https://typesafe.ai
TYPESAFE_API_KEY=

# --- Model roles ("provider:model") -------------------------------------------------
CAIRN_MODEL_DECIDE=groq:openai/gpt-oss-20b,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash-lite
CAIRN_MODEL_EXTRACT=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-3.5-flash,gemini:gemini-2.5-flash
CAIRN_MODEL_AGENT=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.5-flash,gemini:gemini-3.8-flash

# --- Data scope -----------------------------------------------------------------------
CAIRN_REPOS=FalkorDB/FalkorDB,FalkorDB/falkordb-py,FalkorDB/falkordb-ts,FalkorDB/falkordb-go,FalkorDB/falkordb-rs,FalkorDB/JFalkorDB,FalkorDB/GraphRAG-SDK,FalkorDB/QueryWeaver,FalkorDB/FalkorDB-MCPServer,FalkorDB/falkordb-browser,FalkorDB/code-graph,FalkorDB/text-to-cypher,FalkorDB/docs
CAIRN_SINCE=2025-01-01

# --- FalkorDB (local dev outside docker compose) ----------------------------------------
CAIRN_FALKORDB_HOST=localhost
CAIRN_FALKORDB_PORT=6379
CAIRN_GRAPH_NAME=cairn

# --- Public deployment ---------------------------------------------------------------
# When set, every write (sync, approvals, proposals) needs `Authorization: Bearer <token>`.
# Reading and asking stay open. Always set this on a public URL.
CAIRN_ADMIN_TOKEN=
# Questions per client per minute (LLM quota protection).
CAIRN_ASK_RATE_LIMIT_PER_MINUTE=20
# Allowed browser origins for the API (comma-separated).
CAIRN_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Actions: the agent may only write to these repos (comma-separated) ------------------
CAIRN_ACTION_REPOS=
CAIRN_WIKI_REPO=
